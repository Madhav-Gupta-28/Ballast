# Which deployment to talk to.
NETWORK=testnet            # testnet | mainnet

# Signer for the operator key. This key quotes; it can never withdraw from the
# vault (see BallastVault.setOperator). Use a hot key you can afford to lose.
PRIVATE_KEY=

# The deployed vault. Leave blank to run read-only.
VAULT_ADDRESS=

# Venue scope. Venue ids MOVE - both networks changed theirs three times in one
# week - so read this off a live market row rather than trusting a default.
# `pnpm doctor` prints the current one, and says so when the one you have set
# matches nothing.
#
# Read-only against the live mainnet venue, which is what `doctor` and `shadow`
# are for and needs no key:
#
#   NETWORK=mainnet \
#   VENUE_ID=0x458b30c2d72bfd2c6317304a4594ecbafe5f729d3111b65fdc3a33bd48e5432d \
#   OPERATOR_ID=5 pnpm doctor
VENUE_ID=

# Book granularity. Not discoverable through the SDK for binary markets: their
# rows carry tickSize: null and lotSize: null. Defaults are per-network.
# MM_TICK=1000000000000000
# MM_LOT=1000000000000000

# Quoting
MM_HALF_SPREAD=0.005        # each side. Must be well inside the prevailing book:
                           # DreamDEX quotes ~2.3c wide, so 0.005 lands at 1.0c.
MM_QUOTE_SIZE=1            # shares per side
MM_REFRESH_MS=15000
DRY_RUN=true               # log intended orders, send nothing
